{
  "name": "ostatki-sladki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/run-app.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier src tests docs scripts .github README.md ROADMAP.md package.json *.mjs *.json --ignore-unknown --write",
    "format:check": "prettier src tests docs scripts .github README.md ROADMAP.md package.json *.mjs *.json --ignore-unknown --check",
    "lint": "eslint .",
    "check": "pnpm architecture:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "architecture:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/roboto": "^5.2.9",
    "leaflet": "1.9.4",
    "next": "16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  }
}
